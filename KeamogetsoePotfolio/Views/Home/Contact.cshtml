@model KeamogetsoePotfolio.Models.ContactForm

@{
    ViewData["Title"] = "Contact Me";
}

@if (TempData["SuccessMessage"] != null)
{
<div class="alert alert-custom-success alert-dismissible fade show" role="alert">
    @TempData["SuccessMessage"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
}
@if (TempData["ErrorMessage"] != null)
{
<div class="alert alert-danger alert-dismissible fade show" role="alert">
    @TempData["ErrorMessage"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
}

<div class="contact-section-new">
    <h2 class="section-title text-center mb-5">Contact Me</h2>
    <div class="contact-card-new">
        <div class="row g-0">
            <div class="col-md-6 contact-info-col">
                <div class="contact-info-content">
                    <h3 class="info-heading">Lets Connect</h3>
                    <p class="info-text">If you'd like to connect or collaborate, feel free to reach out through any of the platforms below:</p>
                    <ul class="list-unstyled contact-details-list">
                        <li>
                            <i class="fas fa-envelope"></i>
                            <span>selekeamogetsoe@gmail.com</span>
                        </li>
                        <li>
                            <i class="fab fa-linkedin"></i>
                            <span><a href="https://www.linkedin.com/in/keamogetsoe-kgomotso-nicole-sele-455684178/" target="_blank">LinkedIn Profile</a></span>
                        </li>
                        <li>
                            <i class="fab fa-github"></i>
                            <span><a href="https://github.com/Keamo0713" target="_blank">GitHub Profile</a></span>
                        </li>
                        <li>
                            <i class="fas fa-phone-alt"></i>
                            <span>+27 71 289 9785</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6 contact-form-col">
                <form asp-controller="Home" asp-action="SendEmail" method="post">
                    <div class="mb-3">
                        <label for="fullName" class="form-label">Enter your Full Name</label>
                        <input type="text" class="form-control" id="fullName" name="FullName" placeholder="Your Name" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Enter your Email</label>
                        <input type="email" class="form-control" id="email" name="Email" placeholder="Your Email" required>
                    </div>
                    <div class="mb-3">
                        <label for="subject" class="form-label">Subject</label>
                        <input type="text" class="form-control" id="subject" name="Subject" placeholder="Subject" required>
                    </div>
                    <div class="mb-3">
                        <label for="suggestions" class="form-label">Suggestions/Queries</label>
                        <textarea class="form-control" id="suggestions" name="Message" rows="5" placeholder="Your message" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary-custom">Send</button>
                </form>
            </div>
        </div>
    </div>
</div>